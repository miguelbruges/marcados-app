# Copiar a .env y completar. .env nunca se sube al repo (ver .gitignore).

# Desarrollo: sqlite local. Producción: URL de Postgres/Supabase.
DATABASE_URL=sqlite:///./marcados_dev.db

# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-un-valor-aleatorio-largo
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Orígenes permitidos para CORS (separados por coma). En prod: dominio real del frontend.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

ENVIRONMENT=development

# Solo producción: crea el primer usuario admin al arrancar si no existe
# todavía (ver README > "Desplegar para probar desde el celular"). En
# desarrollo local se usa scripts/seed_dev.py en su lugar.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Ruta LOCAL en el servidor al libro real de MARCADOS, usado como plantilla
# de exportación (GET /export/excel, sección 16.2 del handoff). Este archivo
# NUNCA se sube al repo — tiene datos personales de menores de edad. Subilo
# directamente al servidor (o a un volumen persistente) y apuntá acá.
# EXCEL_TEMPLATE_PATH=/ruta/segura/en/el/servidor/MARCADOS.xlsx

# Futuro (no requerido para el MVP actual):
# WHATSAPP_API_TOKEN=
# SUPABASE_URL=
# SUPABASE_KEY=
